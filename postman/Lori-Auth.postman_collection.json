          "script": {
            "type": "text/javascript",
            "exec": [
              "// Luu lai token cu de request 5 kiem tra \"xoay vong\" va request 6 kiem tra \"dung lai token cu\"\r\npm.environment.set(\"oldRefreshToken\", pm.environment.get(\"refreshToken\"));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Refresh tra 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\nconst body = pm.response.json();\r\npm.test(\"Cap token moi, refreshToken khac token cu (xoay vong)\", function () {\r\n    pm.expect(body.accessToken).to.be.a(\"string\").and.not.empty;\r\n    pm.expect(body.refreshToken).to.not.eql(pm.environment.get(\"oldRefreshToken\"));\r\n});\r\npm.environment.set(\"accessToken\", body.accessToken);\r\npm.environment.set(\"refreshToken\", body.refreshToken);"
            ]
          }
        }
      ],
