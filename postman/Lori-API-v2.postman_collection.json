  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// Them 2 header bat buoc cho MOI request cua collection nay\r",
          "pm.request.headers.upsert({ key: \"X-API-Key\", value: pm.environment.get(\"apiKey\") });\r",
          "pm.request.headers.upsert({ key: \"X-App-Signature\", value: pm.environment.get(\"appSignature\") });"
        ],
        "type": "text/javascript"
      }
    }
