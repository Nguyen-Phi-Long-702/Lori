<?xml version="1.0" encoding="utf-8"?>
<!-- Chân danh sách: vòng xoay khi đang tải thêm trang, hoặc dòng báo lỗi chạm để thử lại (LeaderboardFooterAdapter) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp">

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressLeaderboardMore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorSize="24dp"
        app:trackThickness="3dp" />

    <TextView
        android:id="@+id/tvLeaderboardMoreError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:padding="8dp"
        android:text="@string/leaderboard_load_more_error"
        android:textColor="?attr/colorError"
        android:textSize="13sp"
        android:visibility="gone" />

</FrameLayout>