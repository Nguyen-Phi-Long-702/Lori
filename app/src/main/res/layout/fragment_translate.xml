<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupDictionarySubtabs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        app:singleSelection="true"
        app:selectionRequired="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSubtabDictionary"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dictionary_subtab_dictionary" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSubtabTranslate"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/dictionary_subtab_translate" />
    </com.google.android.material.chip.ChipGroup>

    <!-- Thanh tiến trình khi đang dịch: invisible (không phải gone) để không làm nhảy bố cục -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressTranslate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:indeterminate="true"
        android:visibility="invisible" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTranslateSource"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="false"
                    android:clickable="false"
                    android:text="@string/translate_lang_en" />

                <ImageButton
                    android:id="@+id/btnTranslateSwap"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_feature_swap"
                    android:contentDescription="@string/cd_translate_swap"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTranslateTarget"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="false"
                    android:clickable="false"
                    android:text="@string/translate_lang_vi" />
            </LinearLayout>

            <EditText
                android:id="@+id/etTranslateInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="4"
                android:gravity="top|start"
                android:background="@drawable/bg_search_box"
                android:padding="14dp"
                android:hint="@string/translate_input_hint"
                android:inputType="textMultiLine"
                android:textSize="15sp"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/tvTranslateCharCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                android:gravity="end"
                android:textSize="11sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="0/500 ký tự" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTranslateSubmit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/translate_button" />

            <TextView
                android:id="@+id/tvTranslateOffline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/translate_offline_hint"
                android:textColor="?attr/colorError"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvTranslateError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="?attr/colorError"
                android:textSize="12.5sp"
                android:visibility="gone"
                tools:text="Dịch vụ dịch tạm thời chưa khả dụng. Vui lòng thử lại sau" />

            <!-- Thẻ kết quả: ẩn cho tới khi có bản dịch -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTranslateResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/translate_result_title"
                        android:textColor="?attr/colorSecondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTranslateResult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingMultiplier="1.3"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        tools:text="Hạn chót của dự án này đã được gia hạn đến thứ Sáu tuần sau." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>