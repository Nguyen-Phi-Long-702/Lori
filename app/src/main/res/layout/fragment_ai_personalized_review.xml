<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <ImageButton
            android:id="@+id/btnBackAiReview"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_action_back"
            app:tint="?attr/colorOnSurface" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/nav_label_ai_review"
            android:textAppearance="@style/TextAppearance.Lori.Title"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.example.lori.view.PremiumBadgeView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp" />
    </LinearLayout>

    <!-- Thanh tiến trình khi đang tải: invisible (không phải gone) để không làm nhảy bố cục -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressAiReview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="invisible" />

    <LinearLayout
        android:id="@+id/layoutAiReviewError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvAiReviewError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="?attr/colorError"
            android:textSize="14sp"
            tools:text="Cần kết nối Internet để dùng AI Tutor" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAiReviewRetry"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ai_retry_button" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollAiReview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Nhận xét của AI: chỉ hiện khi đã có điểm yếu -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAiReviewSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorPrimaryContainer"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:text="@string/ai_review_eyebrow"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAiReviewSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingMultiplier="1.25"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        android:textSize="14sp"
                        tools:text="AI phát hiện bạn hay sai Present Perfect và Articles." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Chưa có điểm yếu nào -->
            <TextView
                android:id="@+id/tvAiReviewEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingMultiplier="1.3"
                android:padding="24dp"
                android:text="@string/ai_review_empty"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvAiReviewTopicsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:letterSpacing="0.05"
                android:text="@string/ai_review_topics_title"
                android:textColor="?attr/colorSecondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Mỗi chủ đề yếu một dòng (item_ai_weak_row), do AiPersonalizedReviewFragment thêm vào -->
            <LinearLayout
                android:id="@+id/llAiReviewTopics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvAiReviewRecommendTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:letterSpacing="0.05"
                android:text="@string/ai_recommend_title"
                android:textColor="?attr/colorSecondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Mỗi đề xuất một thẻ (item_ai_recommendation) -->
            <LinearLayout
                android:id="@+id/llAiReviewRecommendations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAiReviewStart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/ai_review_start_button" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>