<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <ImageButton
            android:id="@+id/btnBackAiInsight"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_action_back"
            app:tint="?attr/colorOnSurface" />

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_feature_chatbot" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/nav_label_ai_insight"
            android:textAppearance="@style/TextAppearance.Lori.Title"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.example.lori.view.PremiumBadgeView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp" />
    </LinearLayout>

    <!-- Thanh tiến trình khi đang tải: invisible (không phải gone) để không làm nhảy bố cục -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressAiInsight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="invisible" />

    <LinearLayout
        android:id="@+id/layoutAiInsightError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvAiInsightError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="?attr/colorError"
            android:textSize="14sp"
            tools:text="Cần kết nối Internet để dùng AI Tutor" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAiInsightRetry"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ai_retry_button" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollAiInsight"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAiInsightSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorPrimaryContainer"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:text="@string/ai_insight_overview_title"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAiInsightSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingMultiplier="1.25"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        android:textSize="14sp"
                        tools:text="Bạn nắm khá tốt nội dung này nhưng còn nhầm ở một vài chỗ." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Làm đúng hết nên không có điểm yếu -->
            <TextView
                android:id="@+id/tvAiInsightNoWeak"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingMultiplier="1.3"
                android:padding="24dp"
                android:text="@string/ai_insight_no_weak"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvAiInsightWeakTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:letterSpacing="0.05"
                android:text="@string/ai_insight_weak_title"
                android:textColor="?attr/colorSecondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Mỗi chỗ yếu một dòng (item_ai_weak_row), do QuizExamAiInsightFragment thêm vào -->
            <LinearLayout
                android:id="@+id/llAiInsightWeak"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvAiInsightPatternsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:letterSpacing="0.05"
                android:text="@string/ai_insight_patterns_title"
                android:textColor="?attr/colorSecondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAiInsightPatterns"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.3"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                tools:text="• Nhầm a/an/the" />

            <TextView
                android:id="@+id/tvAiInsightRecommendTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:letterSpacing="0.05"
                android:text="@string/ai_recommend_title"
                android:textColor="?attr/colorSecondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Mỗi đề xuất một thẻ (item_ai_recommendation) -->
            <LinearLayout
                android:id="@+id/llAiInsightRecommendations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAiInsightStart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/ai_insight_start_button" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>