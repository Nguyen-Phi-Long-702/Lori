<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <ImageButton
            android:id="@+id/btnBackAiExercise"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_action_back"
            app:tint="?attr/colorOnSurface" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/nav_label_ai_exercise"
            android:textAppearance="@style/TextAppearance.Lori.Title"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.example.lori.view.PremiumBadgeView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp" />
    </LinearLayout>

    <!-- Đang nhờ AI soạn bài: mất vài giây tới vài chục giây -->
    <LinearLayout
        android:id="@+id/layoutExerciseLoading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/ai_exercise_loading"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutExerciseError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvExerciseError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="?attr/colorError"
            android:textSize="14sp"
            tools:text="Máy chủ đang gặp sự cố. Vui lòng thử lại sau" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExerciseRetry"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ai_retry_button" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollExercise"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Đang làm bài -->
            <LinearLayout
                android:id="@+id/groupExercisePlaying"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressExercise"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:indeterminate="false" />

                <TextView
                    android:id="@+id/tvExerciseEyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Câu 1/5 · Present Perfect" />

                <TextView
                    android:id="@+id/tvExerciseType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_exam_badge"
                    android:backgroundTint="?attr/colorPrimaryContainer"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    tools:text="ĐIỀN VÀO CHỖ TRỐNG" />

                <TextView
                    android:id="@+id/tvExerciseQuestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingMultiplier="1.15"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    tools:text="I ___ never been to Japan before." />

                <!-- Bài trắc nghiệm -->
                <LinearLayout
                    android:id="@+id/groupExerciseChoices"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExerciseOptionA"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="start|center_vertical"
                        tools:text="A. have" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExerciseOptionB"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="start|center_vertical"
                        tools:text="B. has" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExerciseOptionC"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="start|center_vertical"
                        tools:text="C. had" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExerciseOptionD"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="start|center_vertical"
                        tools:text="D. having" />
                </LinearLayout>

                <!-- Bài điền vào chỗ trống -->
                <LinearLayout
                    android:id="@+id/groupExerciseFill"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/etExerciseAnswer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_search_box"
                        android:hint="@string/ai_exercise_answer_hint"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:maxLength="100"
                        android:padding="14dp"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExerciseCheck"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/ai_exercise_check_button" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvExerciseFeedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:lineSpacingMultiplier="1.2"
                    android:padding="14dp"
                    android:textSize="14sp"
                    android:visibility="gone"
                    tools:text="Chính xác! Dùng Present Perfect với never."
                    tools:visibility="visible" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExerciseNext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/quiz_next_button"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Kết quả cả lượt -->
            <LinearLayout
                android:id="@+id/groupExerciseResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvExerciseScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="48sp"
                    android:textStyle="bold"
                    tools:text="4/5" />

                <TextView
                    android:id="@+id/tvExerciseResultSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp"
                    tools:text="Bài tập AI · Present Perfect" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExerciseMore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="@string/ai_exercise_more_button" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExerciseFinish"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/quiz_finish_button" />
            </LinearLayout>
        </FrameLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>